{
  "manifest_version": 3,
  "name": "chess.com moves",
  "version": "1.0",
  "description": "Draws the best move on the chess.com board.",
  "permissions": ["debugger"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "back.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.chess.com/*"],
      "js": ["page.js"],
      "run_at": "document_idle"
    }
  ]
}
